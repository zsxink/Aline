/target/

# macOS
.DS_Store
**/.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Environment / secrets
.env
.env.*

# Backup / swap files
*.swp
*.swo
*~

# Skill / tool caches
.impeccable/
.codegraph/

# 工程守卫生成的 Python 缓存与隔离 Cargo 构建产物。
__pycache__/
*.pyc
**/cargo-target/
**/target/

# 本地验证产物与临时日志：不入库。
# 可复现输入（golden/夹具/基线）在 crates/*/tests/fixtures 与 scripts/fixtures。
/logs/
*.log

# 已清理的过程报告目录不得重新生成入库；交接统一放 tmp/。
/docs/validation/
/docs/maintenance/
/reports/
/tmp/
