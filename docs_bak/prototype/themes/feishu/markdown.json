{
  "common": {
    "typography": {
      "bodyFamilies": [
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ],
      "headingFamilies": [
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ],
      "codeFamilies": [
        "SFMono-Regular",
        "Consolas",
        "monospace"
      ],
      "bodySize": 16,
      "bodyWeight": 400,
      "lineHeight": 1.75,
      "bodyAlign": "left"
    },
    "headings": {
      "h1": {
        "size": 32,
        "weight": 700,
        "lineHeight": 1.3,
        "align": "left",
        "marginBefore": 0,
        "marginAfter": 16
      },
      "h2": {
        "size": 24,
        "weight": 600,
        "lineHeight": 1.35,
        "align": "left",
        "marginBefore": 30,
        "marginAfter": 14
      },
      "h3": {
        "size": 20,
        "weight": 600,
        "lineHeight": 1.4,
        "align": "left",
        "marginBefore": 26,
        "marginAfter": 12
      },
      "h4": {
        "size": 17,
        "weight": 600,
        "lineHeight": 1.45,
        "align": "left",
        "marginBefore": 22,
        "marginAfter": 10
      },
      "h5": {
        "size": 15,
        "weight": 600,
        "lineHeight": 1.5,
        "align": "left",
        "marginBefore": 18,
        "marginAfter": 8
      },
      "h6": {
        "size": 14,
        "weight": 600,
        "lineHeight": 1.5,
        "align": "left",
        "marginBefore": 16,
        "marginAfter": 8
      }
    },
    "spacing": {
      "paragraphAfter": 16,
      "listItemGap": 4,
      "blockBefore": 20,
      "blockAfter": 24,
      "quotePadding": 16
    },
    "inline": {
      "strong": {
        "weight": 700
      },
      "emphasis": {
        "italic": true
      },
      "strike": {
        "enabled": true
      },
      "link": {
        "underline": false
      },
      "codeSpan": {
        "radius": 4
      }
    },
    "blockquote": {
      "lineColor": "#d1d9e0"
    },
    "task": {
      "color": "#1f2328"
    },
    "rule": {
      "color": "#d1d9e0"
    },
    "image": {
      "captionColor": "#59636e"
    },
    "callout": {
      "note": {},
      "tip": {},
      "important": {},
      "warning": {},
      "caution": {}
    },
    "formula": {},
    "diagram": {},
    "codeBlock": {
      "radius": 6,
      "paddingX": 20,
      "paddingY": 18,
      "fontSize": 13,
      "lineHeight": 1.6
    },
    "table": {
      "headerWeight": 600,
      "cellPaddingX": 13,
      "cellPaddingY": 9,
      "rowLineHeight": 1.65,
      "zebra": true
    }
  },
