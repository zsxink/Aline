===== 4. StorageRange contract =====

$ sed -n 118,135p crates/aline-source/src/storage.rs
/// 绑定存储基线的原始字节半开范围，不等同源码 UTF-8 范围。
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct StorageRange {
    baseline: BaselineId,
    bytes: Range<usize>,
}

impl StorageRange {
    /// 返回原始字节区间，含 BOM/CRLF 等存储表示。
    pub fn byte_range(&self) -> Range<usize> {
        self.bytes.clone()
    }

    /// 返回所属基线身份。
    pub fn baseline_id(&self) -> &BaselineId {
        &self.baseline
    }
}

$ sed -n 186,214p crates/aline-source/src/storage.rs
    /// 构造绑定本基线的字节范围；不把存储字节误作 UTF-8 字符边界。
    pub fn range(&self, bytes: Range<usize>) -> Result<StorageRange, StorageError> {
        if bytes.start > bytes.end {
            return Err(StorageError::ReversedRange);
        }
        if bytes.end > self.bytes.len() {
            return Err(StorageError::OutOfBounds {
                offset: bytes.end,
                len: self.bytes.len(),
            });
        }
        Ok(StorageRange {
            baseline: self.id.clone(),
            bytes,
        })
    }

    /// 复验基线身份后读取原 bytes；错误基线即使文本相同也拒绝。
    pub fn slice(&self, range: &StorageRange) -> Result<&[u8], StorageError> {
        if range.baseline != self.id {
            return Err(StorageError::BaselineMismatch);
        }
        self.bytes
            .get(range.bytes.clone())
            .ok_or(StorageError::OutOfBounds {
                offset: range.bytes.end,
                len: self.bytes.len(),
            })
    }

===== 5. decode boundary =====

$ sed -n 117,167p crates/aline-source/src/decode.rs
/// 先验预算，再验证编码并解码存储视图。
///
/// 失败时不修改输入快照，也不返回部分源码。成功结果携带与输入相同的
/// 存储基线身份，供后续编码绑定内容相等证据。
pub fn decode(
    storage: &StorageSnapshot,
    budget: StorageBudget,
) -> Result<DecodedSource, DecodeError> {
    let bytes = storage.bytes();
    let needed = bytes.len();
    let limit = budget.max_bytes();
    if needed > limit {
        return Err(DecodeError::BudgetExceeded { needed, limit });
    }
    if bytes.starts_with(&[0xff, 0xfe]) {
        return Err(DecodeError::Utf16Bom {
            little_endian: true,
        });
    }
    if bytes.starts_with(&[0xfe, 0xff]) {
        return Err(DecodeError::Utf16Bom {
            little_endian: false,
        });
    }
    let text = std::str::from_utf8(bytes).map_err(|error| DecodeError::InvalidUtf8 {
        valid_up_to: error.valid_up_to(),
        error_len: error.error_len(),
    })?;
    let (has_bom, body) = match text.strip_prefix('\u{feff}') {
        Some(body) => (true, body),
        None => (false, text),
    };
    let (crlf_pairs, unpaired_lf) = scan_line_endings(body.as_bytes());
    let line_ending = if crlf_pairs > unpaired_lf {
        LineEnding::Crlf
    } else {
        LineEnding::Lf
    };
    Ok(DecodedSource {
        baseline: SourceBaseline::new(
            storage.clone(),
            body.to_owned(),
            StorageMetadata {
                has_bom,
                crlf_pairs,
                unpaired_lf,
                line_ending,
            },
        ),
    })
}

===== 6. encode boundary =====

$ sed -n 84,134p crates/aline-source/src/encode.rs
/// 把冻结编辑源码编码为完整待写 bytes。
///
/// 相等时返回基线原 bytes（含 BOM、混合行尾、孤立 CR 与末尾状态）；不等时
/// 重放 BOM 和 [`SourceBaseline`] 记录的行尾策略，平票为 LF。基线无 BOM 而
/// 冻结源码以 U+FEFF 开头时，补写一个头部 BOM 保护该正文字符，预算计入。
/// 编码不修改基线或输入文本，不隐式整理行尾，也不增删末尾换行。
pub fn encode(
    frozen_source: &str,
    baseline: &SourceBaseline,
    budget: StorageBudget,
) -> Result<EncodedBytes, EncodeError> {
    let limit = budget.max_bytes();
    if frozen_source == baseline.source() {
        let needed = baseline.storage().bytes().len();
        check_budget(needed, limit)?;
        return Ok(EncodedBytes {
            bytes: baseline.storage().bytes().to_vec(),
            baseline: baseline.id().clone(),
            reused_original: true,
        });
    }

    let policy = baseline.metadata().line_ending();
    let emit_bom = emits_header_bom(frozen_source, baseline);
    let mut body_len = 0usize;
    walk_body(frozen_source, policy, |chunk| {
        body_len = body_len
            .checked_add(chunk.len())
            .ok_or(EncodeError::LengthOverflow)?;
        Ok(())
    })?;
    let bom_len = if emit_bom { BOM.len() } else { 0 };
    let needed = body_len
        .checked_add(bom_len)
        .ok_or(EncodeError::LengthOverflow)?;
    check_budget(needed, limit)?;

    let mut bytes = Vec::with_capacity(needed);
    if emit_bom {
        bytes.extend_from_slice(BOM);
    }
    walk_body(frozen_source, policy, |chunk| {
        bytes.extend_from_slice(chunk);
        Ok(())
    })?;
    Ok(EncodedBytes {
        bytes,
        baseline: baseline.id().clone(),
        reused_original: false,
    })
}

