   377	#[test]
   378	fn mapping_point_budget_also_caps_projection_segments() -> Result<(), Box<dyn Error>> {
   379	    let source = "[a](u)\n";
   380	    let baseline = parse_text(source)?;
   381	    let points = baseline.stats().mapping_points();
   382	    let segments = baseline.projection().segments().len();
   383	    assert_eq!(points, 2);
   384	    assert_eq!(segments, 3);
   385	    assert!(
   386	        segments > points,
   387	        "segment count must exceed the point count so the segment limit fires first"
   388	    );
   389	
   390	    // max_mapping_points 兼作片段数上限：索引点恰好够用（2 <= 2），
   391	    // 但片段数（3）超限，因此失败来自片段数维度而非索引点维度。
   392	    let snapshot = TextSnapshot::new(source.to_string(), TextBudget::new(BUDGET))?;
   393	    let segment_limited = parse(
   394	        &snapshot,
   395	        ParseConfig::m0(),
   396	        ParseBudget::m0().with_max_mapping_points(points),
   397	    );
   398	    assert!(
   399	        matches!(
   400	            segment_limited,
   401	            Err(ParseError::Mapping(MappingError::BudgetExceeded))
   402	        ),
   403	        "segments ({segments}) exceed the limit ({points}) while points stay within it"
   404	    );
   405	    let segment_exact = parse(
   406	        &snapshot,
   407	        ParseConfig::m0(),
   408	        ParseBudget::m0().with_max_mapping_points(segments),
   409	    )?;
   410	    assert!(segment_exact.diagnostics().is_empty());
   411	    assert_eq!(segment_exact.projection().segments().len(), segments);
   412	    assert_eq!(segment_exact.stats().mapping_points(), points);
   413	    Ok(())
   414	}

