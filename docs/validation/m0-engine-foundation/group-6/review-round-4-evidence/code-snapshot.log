   523	fn block_signature(
   524	    parsed: &Parsed,
   525	    block_index: usize,
   526	    base: usize,
   527	    relocation: Option<&ReusedBlock>,
   528	) -> Result<BlockSignature, Box<dyn Error>> {
   529	    let block = parsed.blocks().get(block_index).ok_or("missing block")?;
   530	    let block_range = block.range().byte_range();
