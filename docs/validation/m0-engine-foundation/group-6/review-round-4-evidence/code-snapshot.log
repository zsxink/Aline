   472	/// 复用块与全量重算的逐块签名：文本、种类、范围、映射片段（来源/绘制/precision）、
   473	/// 保护范围与样式范围都重定位到新快照坐标后比较。
   474	///
   475	/// M0 的 `Parsed` 不暴露链接目标；标题作为导航目标由 `BlockKind::Heading` 的文本与
   476	/// 范围覆盖，而含 HTML、脚注或引用定义的文档在 `global_dependency` 处整体拒绝复用，
   477	/// 因此链接/脚注目标本身在复用路径上不可比，这里不作伪装比较。
   478	#[derive(Debug, Eq, PartialEq)]
   479	struct BlockSignature {
   480	    kind: BlockKind,
   481	    text: String,
   482	    range: Range<usize>,
   483	    segments: Vec<SegmentSignature>,
   484	    protected: Vec<(Range<usize>, ProtectionKind)>,
   485	    styled: Vec<(Range<usize>, TextStyle)>,
   486	}
   487	
   488	#[derive(Debug, Eq, PartialEq)]
   489	struct SegmentSignature {
   490	    source: Range<usize>,
