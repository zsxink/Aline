   609	    for range in parsed.styled_ranges() {
   610	        let bytes = range.range().byte_range();
   611	        if bytes.start < block_range.start || bytes.end > block_range.end {
   612	            continue;
   613	        }
   614	        styled.push((relocate(bytes.start)?..relocate(bytes.end)?, range.style()));
   615	    }
