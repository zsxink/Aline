   570	                    .start
   571	                    .checked_add(start - source.start)
   572	                    .ok_or("drawn offset overflow")?;
   573	                let drawn_end = drawn
   574	                    .start
   575	                    .checked_add(end - source.start)
   576	                    .ok_or("drawn offset overflow")?;
   577	                drawn_start..drawn_end
   578	            }
   579	            MappingPrecision::Hidden => drawn.start..drawn.start,
   580	            MappingPrecision::Aligned | MappingPrecision::Synthetic => {
   581	                if start != source.start || end != source.end {
