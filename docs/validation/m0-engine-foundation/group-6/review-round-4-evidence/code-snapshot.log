   333	fn raw_fallback(
   334	    snapshot: &TextSnapshot,
   335	    config: ParseConfig,
   336	    budget: ParseBudget,
   337	    kind: DiagnosticKind,
   338	    mut stats: ParseStats,
   339	) -> Result<Parsed, ParseError> {
   340	    let len = snapshot.len_bytes();
   341	    let source_range = snapshot.src_range(0..len).map_err(ParseError::Source)?;
   342	    let source = snapshot
   343	        .slice(&source_range, TextBudget::new(budget.max_source_bytes()))
   344	        .map_err(ParseError::Source)?;
   345	    let drawn = source.into_owned();
   346	    let mapping_points = drawn.chars().count().saturating_add(1);
   347	    let mut segments = Vec::new();
   348	    if len > 0 {
   349	        segments.push(
   350	            crate::mapping::MappingSegment::new(
   351	                0..len,
   352	                source_range.clone(),
   353	                crate::mapping::MappingPrecision::Exact,
   354	            )
   355	            .map_err(ParseError::Mapping)?,
   356	        );
   357	    }
   358	    let projection = Projection::from_segments(
   359	        snapshot.clone(),
   360	        source_range.clone(),
   361	        drawn,
   362	        segments,
   363	        MappingBudget::new(budget.max_rewritten_bytes(), budget.max_mapping_points()),
   364	    )
   365	    .map_err(ParseError::Mapping)?;
   366	    stats.mapping_points = mapping_points;
   367	    let blocks = if len > 0 {
   368	        vec![Block::new(source_range.clone(), BlockKind::Raw)]
   369	    } else {
   370	        Vec::new()
   371	    };
   372	    let protected = if len > 0 {
   373	        vec![ProtectedRange::new(
   374	            source_range.clone(),
   375	            ProtectionKind::RawFallback,
   376	        )]
   377	    } else {
   378	        Vec::new()
   379	    };
   380	    let diagnostics = vec![Diagnostic::new(source_range, kind)];
   381	    Ok(Parsed {
   382	        snapshot: snapshot.clone(),
   383	        config,
   384	        projection,
   385	        blocks,
   386	        gaps: Vec::new(),
   387	        protected,
   388	        styled: Vec::new(),
   389	        diagnostics,
   390	        front_matter: None,
   391	        rewrite: None,
   392	        stats,
   393	    })
   394	}

