   558	            }
   559	            _ => source.end > block_range.start && source.start < block_range.end,
   560	        };
   561	        if !overlaps {
   562	            continue;
   563	        }
   564	        let start = source.start.max(block_range.start);
   565	        let end = source.end.min(block_range.end);
   566	        let drawn = segment.drawn_range();
   567	        let clipped_drawn = match segment.precision() {
   568	            MappingPrecision::Exact => {
