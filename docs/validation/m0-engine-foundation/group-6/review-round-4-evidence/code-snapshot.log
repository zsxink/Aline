   492	    precision: MappingPrecision,
   493	}
   494	
   495	fn assert_all_reused_pairs_match(
   496	    old: &Parsed,
   497	    new: &Parsed,
   498	    outcome: &ReuseOutcome,
   499	) -> Result<(), Box<dyn Error>> {
   500	    for pair in outcome.reused() {
   501	        let old_signature =
   502	            block_signature(old, pair.old_index(), pair.new_range().start, Some(pair))?;
   503	        let new_signature = block_signature(new, pair.new_index(), pair.new_range().start, None)?;
   504	        assert_eq!(
   505	            old_signature,
   506	            new_signature,
   507	            "reused block {} must match full reparse block {}",
   508	            pair.old_index(),
   509	            pair.new_index()
   510	        );
   511	        assert_eq!(
   512	            pair.translate(pair.old_range().start),
   513	            Some(pair.new_range().start)
   514	        );
   515	        assert_eq!(
   516	            pair.translate(pair.old_range().end),
   517	            Some(pair.new_range().end)
   518	        );
   519	    }
   520	    Ok(())
   521	}
