   588	            source: relocate(start)?..relocate(end)?,
   589	            drawn: clipped_drawn
   590	                .start
   591	                .checked_sub(drawn_base)
   592	                .ok_or("drawn start before block")?
   593	                ..clipped_drawn
   594	                    .end
   595	                    .checked_sub(drawn_base)
   596	                    .ok_or("drawn end before block")?,
   597	            precision: segment.precision(),
   598	        });
   599	    }
   600	    let mut protected = Vec::new();
   601	    for range in parsed.protected_ranges() {
   602	        let bytes = range.range().byte_range();
   603	        if bytes.start < block_range.start || bytes.end > block_range.end {
   604	            continue;
   605	        }
   606	        protected.push((relocate(bytes.start)?..relocate(bytes.end)?, range.kind()));
   607	    }
